# ── Required ───────────────────────────────────────────────
# Vercel Blob store (applications + contact messages live here).
# Get it from: Vercel → fest-web-main → Storage → fest-data → .env.local tab
BLOB_READ_WRITE_TOKEN=

# Password for the /admin review console. Any long random string.
ADMIN_KEY=

# ── Auth: pick ONE backend, or none ────────────────────────
# Option A — Firebase (recommended: no Google Cloud setup, 50k free users)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Option B — Clerk (dev instance caps at 100 users)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Option C — NextAuth + your own Google Cloud OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://fest-web-main.vercel.app

# With none of the above set, the site still works — /ticket falls back
# to email lookup instead of sign-in.
